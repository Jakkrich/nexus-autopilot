{
    "name": "ag-nexus-autopilot",
    "displayName": "Nexus Autopilot for Antigravity",
    "description": "ระบบ Autopilot อัจฉริยะสำหรับ Antigravity: คลิกปุ่ม Run/Allow/Accept ในแชตและเลื่อนหน้าจออัตโนมัติ พร้อมแดชบอร์ดภาษาไทย 100%",
    "version": "1.1.9",
    "icon": "media/icon.png",
    "author": "Jakkrich Changgon",
    "publisher": "jakkrich-changgon",
    "repository": {
        "type": "git",
        "url": "https://github.com/Jakkrich/nexus-autopilot"
    },
    "engines": {
        "vscode": "^1.60.0"
    },
    "extensionKind": [
        "ui"
    ],
    "categories": [
        "Other",
        "Programming Languages",
        "Machine Learning"
    ],
    "activationEvents": [
        "*",
        "onStartupFinished",
        "onCommand:nexus-autopilot.openDashboard",
        "onCommand:nexus-autopilot.openSettings",
        "onCommand:nexus-autopilot.toggleAccept",
        "onCommand:nexus-autopilot.toggleScroll",
        "onCommand:nexus-autopilot.enable",
        "onCommand:nexus-autopilot.disable",
        "onCommand:ag-auto.openSettings",
        "onCommand:ag-auto.enable",
        "onCommand:ag-auto.disable"
    ],
    "main": "./src/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "nexus-autopilot.openDashboard",
                "title": "Nexus Autopilot: เปิดแดชบอร์ด & การตั้งค่า (Open Dashboard)"
            },
            {
                "command": "nexus-autopilot.openSettings",
                "title": "Nexus Autopilot: เปิดหน้าต่างแดชบอร์ด & การตั้งค่า (Open Settings & Dashboard)"
            },
            {
                "command": "nexus-autopilot.toggleAccept",
                "title": "Nexus Autopilot: สลับเปิด/ปิด คลิกอัตโนมัติ (Toggle Auto Click)"
            },
            {
                "command": "nexus-autopilot.toggleScroll",
                "title": "Nexus Autopilot: สลับเปิด/ปิด เลื่อนจออัตโนมัติ (Toggle Auto Scroll)"
            },
            {
                "command": "nexus-autopilot.enable",
                "title": "Nexus Autopilot: เปิดใช้งาน (Inject Script)"
            },
            {
                "command": "nexus-autopilot.disable",
                "title": "Nexus Autopilot: ปิดใช้งาน (Remove Script)"
            },
            {
                "command": "ag-auto.openSettings",
                "title": "Nexus Autopilot: แดชบอร์ด & การตั้งค่า (AG Auto Settings)"
            },
            {
                "command": "ag-auto.enable",
                "title": "Nexus Autopilot: เปิดใช้งาน (AG Auto Enable)"
            },
            {
                "command": "ag-auto.disable",
                "title": "Nexus Autopilot: ปิดใช้งาน (AG Auto Disable)"
            }
        ],
        "configuration": {
            "title": "Nexus Autopilot",
            "properties": {
                "nexus-autopilot.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "เปิด/ปิดการทำงานของ Nexus Autopilot ทั้งหมด"
                },
                "nexus-autopilot.scrollEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "เปิด/ปิดระบบเลื่อนหน้าต่างแชตอัตโนมัติ (Auto Scroll)"
                },
                "nexus-autopilot.scrollPauseMs": {
                    "type": "number",
                    "default": 7000,
                    "description": "ระยะเวลาหน่วงเมื่อผู้ใช้เลื่อนหน้าจอด้วยตนเอง (มิลลิวินาที)"
                },
                "nexus-autopilot.scrollIntervalMs": {
                    "type": "number",
                    "default": 500,
                    "description": "ความถี่ในการตรวจจับและเลื่อนจออัตโนมัติ (มิลลิวินาที)"
                },
                "nexus-autopilot.clickIntervalMs": {
                    "type": "number",
                    "default": 1000,
                    "description": "ความถี่ในการสแกนและคลิกปุ่มอัตโนมัติ (มิลลิวินาที)"
                },
                "nexus-autopilot.clickPatterns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "Allow",
                        "Always Allow",
                        "Run",
                        "Keep Waiting",
                        "Accept",
                        "Submit",
                        "Yes, allow this time",
                        "Yes, and always allow"
                    ],
                    "description": "รายการข้อความของปุ่มที่ต้องการให้ระบบคลิกอัตโนมัติ"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "echo ok",
        "package": "npx @vscode/vsce package --no-dependencies"
    }
}